{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:veramesh:veraport:v1:event",
  "title": "VeraPort V1 response/event",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "ok"],
  "properties": {
    "protocol_version": {"const": "veraport-v1"},
    "request_id": {"type": ["string", "null"]},
    "ok": {"type": "boolean"},
    "result": {"type": "object"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"ok": {"const": true}}}, "then": {"required": ["result"], "not": {"required": ["error"]}}},
    {"if": {"properties": {"ok": {"const": false}}}, "then": {"required": ["error"], "not": {"required": ["result"]}}}
  ]
}
