[Unit]
Description=VeraMesh public MCP/OAuth gateway
After=network.target

[Service]
Type=simple
ExecStartPre=/var/packages/VeraMeshGateway/target/bin/veramesh-gateway -listen 127.0.0.1:17446 -controller-config /var/packages/VeraMeshGateway/var/gateway/controller.json -oauth-config /var/packages/VeraMeshGateway/var/gateway/oauth.json -check-config
ExecStart=/var/packages/VeraMeshGateway/target/bin/run-veramesh-gateway.sh
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
